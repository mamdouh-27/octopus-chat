{
  "name": "octopus-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs npm run dev:web",
    "build": "node scripts/run.mjs npm run build:web",
    "tauri": "node scripts/run.mjs node node_modules/@tauri-apps/cli/tauri.js",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "dev:web": "vite",
    "build:web": "tsc && vite build",
    "tauri:dev": "node scripts/run.mjs node node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node scripts/run.mjs node node_modules/@tauri-apps/cli/tauri.js build",
    "test:rust": "node scripts/run.mjs cargo test --manifest-path src-tauri/Cargo.toml -p octopus-core",
    "test": "npm run typecheck && npm run test:rust"
  },
  "dependencies": {
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.51.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "description": "Octopus Chat - local-first AI agent desktop app",
  "license": "MIT"
}
